# Base de datos
MYSQL_URI=mysql+pymysql://USUARIO:CONTRASENA@HOST:PUERTO/capstone

# Secreto con el que se firman las sesiones. Obligatorio y sin valor por
# defecto: uno de relleno parece configurado y permite a cualquiera que lea
# el codigo firmar tokens validos. Genera el tuyo con
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=

# Horas que dura una sesion antes de tener que volver a entrar.
JWT_HORAS=8

# Alta de cuentas nuevas. Cerrada por defecto: la cuota de la API es de la
# clave y se reparte entre todos los usuarios de la instancia.
REGISTRO_ABIERTO=false

# Almacenamiento de los PDF cargados. Dentro se crea una carpeta por usuario,
# para que el aislamiento entre cuentas valga tambien en el disco.
STORAGE_DIR=storage/pdfs

# Origenes que pueden llamar a la API desde un navegador, separados por comas.
# No admite '*': con sesiones activas, el comodin haria que los navegadores
# rechazaran las peticiones y la aplicacion dejara de funcionar sin decir por
# que. Al desplegar, anade aqui el dominio del frontend.
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# Modo del modelo:
#   real  -> llama a la API de Gemini y consume cuota
#   mock  -> respuestas y embeddings simulados, sin red ni coste.
#            Util para desarrollo, pruebas y demostraciones.
GEMINI_MODE=mock
GEMINI_API_KEY=TU_API_KEY_AQUI

# Modelos. gemini-embedding-001 sustituye a text-embedding-004, retirado
# por Google. Entrega 3072 dimensiones y se truncan a 768 para no inflar
# el almacenamiento en MySQL ni la busqueda en memoria.
GEMINI_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Revisión del código guardada con cada nueva ejecución y métrica. Es opcional:
# si falta se registra como desconocida, nunca se intenta adivinar.
APP_REVISION=

# OCR de respaldo para PDF escaneados. Solo hace falta si Tesseract no
# esta en el PATH del sistema.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
