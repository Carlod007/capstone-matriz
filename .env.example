# Variables de docker-compose.yml. Copia este archivo como .env y rellenalo:
#
#     copy .env.example .env
#
# Este .env es el del despliegue con Docker y es distinto de backend/.env, que
# usa la ejecucion a mano. Ninguno de los dos se versiona.

# Contrasena de root de MySQL. La elige quien despliega; dentro de Docker la
# base no esta expuesta al exterior, pero sigue sin convenir una previsible.
MYSQL_PASSWORD=

MYSQL_BASE=capstone

# Secreto con el que se firman las sesiones. Sin valor por defecto a
# proposito. Genera uno con:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=

JWT_HORAS=8

# Alta de cuentas por HTTP. Cerrada: la cuota de la API es de la clave y se
# reparte entre todos los usuarios de la instancia.
REGISTRO_ABIERTO=false

# mock = sin llamadas a la API, sin coste, textos de relleno.
# real = respuestas del modelo, consume cuota.
GEMINI_MODE=mock
GEMINI_API_KEY=

# Origenes que pueden llamar a la API desde un navegador, separados por comas.
# Con el proxy de nginx delante, la aplicacion y la API comparten origen y esto
# deja de intervenir; se conserva por si algun dia se llama a la API desde
# fuera.
CORS_ORIGENES=http://localhost:8080

# Direccion de la API vista desde el navegador. `/api` significa "el mismo
# servidor que sirvio la pagina", que es lo que hace falta con nginx delante.
# Vite la incrusta al compilar, asi que cambiarla obliga a
# `docker compose build frontend`.
VITE_API_BASE=/api

# Dominio del servidor. Con uno definido, Caddy consigue un certificado de
# Let's Encrypt y sirve por HTTPS; sin el, sirve por HTTP sin cifrar, que es lo
# que hace falta en desarrollo.
#
# Si no tienes dominio propio, sslip.io convierte cualquier IP en un nombre sin
# registrarse en ningun sitio: para 147.224.233.59 seria
#     DOMINIO=147-224-233-59.sslip.io
DOMINIO=

# Puertos que se publican en la maquina anfitriona. El del backend solo escucha
# en 127.0.0.1, para depurar desde el propio servidor: al navegador llega por
# el proxy. En un servidor, PUERTO_HTTP=80 y PUERTO_HTTPS=443; el 80 hace falta
# aunque se use HTTPS, porque por ahi comprueba Let's Encrypt el dominio.
PUERTO_BACKEND=8000
PUERTO_HTTP=8080
PUERTO_HTTPS=8443
